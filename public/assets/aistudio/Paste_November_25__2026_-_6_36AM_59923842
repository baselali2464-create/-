<script>
  (function() {
    const loadingBar = document.getElementById('loading-bar');
    const statusText = document.getElementById('loading-status-text');
    
    if (!loadingBar || !statusText) return;

    const stages = [
      { width: '35%', text: 'تهيئة الخوارزميات التعليمية...' },
      { width: '70%', text: 'تخصيص المسارات التقنية...' },
      { width: '92%', text: 'جاهز للانطلاق...' }
    ];

    let currentStage = 0;
    const interval = setInterval(() => {
      if (currentStage < stages.length) {
        loadingBar.style.width = stages[currentStage].width;
        statusText.textContent = stages[currentStage].text;
        currentStage++;
      } else {
        clearInterval(interval);
      }
    }, 850);
  })();
