<span class="material-symbols-outlined text-[22px]">cloud_upload</span>
</span>
<div>
<h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">رفع مرجع رقمي جديد إلى دورة الفحص</h3>
<span class="font-label-sm text-label-sm text-on-surface-variant">يدعم صيغ PDF، EPUB، بحجم أقصى 250 ميجابايت</span>
</div>
</div>
<button class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high" onclick="closeUploadModal()">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
<div class="p-space-lg flex flex-col gap-space-md">
<!-- Drag & Drop Zone -->
<div class="p-space-xl rounded-xl bg-surface-container-low hover:bg-surface-container-high transition-colors flex flex-col items-center justify-center text-center cursor-pointer group">
<span class="material-symbols-outlined text-[48px] text-primary group-hover:scale-110 transition-transform">upload_file</span>
<span class="font-label-lg text-label-lg text-on-surface font-bold mt-2">اسحب وأفلت ملف المرجع هنا</span>
<span class="font-body-sm text-body-sm text-on-surface-variant mt-1">أو تصفح الملفات من جهازك الشخصي</span>
<span class="px-space-md py-1 rounded-full bg-surface-container text-label-sm font-label-sm text-outline mt-3">سيخضع الملف تلقائياً لـ 6 مراحل فحص أمني وبنيوي</span>
</div>
<!-- Metadata Inputs -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">عنوان الكتاب المعتمد</label>
<input class="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface focus:outline-none focus:bg-white shadow-sm" placeholder="مثال: هندسة الخوارزميات وتراكيب البيانات" type="text"/>
</div>
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">اسم المؤلف أو الجهة الأكاديمية</label>
<input class="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface focus:outline-none focus:bg-white shadow-sm" placeholder="مثال: د. أحمد المنصور" type="text"/>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">التخصص / الكلية التابعة</label>
<select class="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface focus:outline-none shadow-sm cursor-pointer">
<option>كلية علوم الحاسب والمعلوماتية</option>
<option>كلية الهندسة والعلوم التطبيقية</option>
<option>كلية الطب والعلوم الصحية</option>
<option>كلية إدارة الأعمال والاقتصاد الرقمي</option>
</select>
</div>
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">مستوى إتاحة الوصول الأولي</label>
<select class="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface focus:outline-none shadow-sm cursor-pointer">
<option>عام لكافة الطلبة والأساتذة</option>
<option>خاص بالطلاب المسجلين بالمقرر فقط</option>
<option>يتطلب طلب رخصة فردي</option>
</select>
</div>
</div>
</div>
<div class="p-space-lg bg-surface-container-low flex items-center justify-end gap-space-sm">
<button class="px-space-md py-2 rounded-lg bg-surface-container text-on-surface font-label-lg text-label-lg hover:bg-surface-container-high transition-colors" onclick="closeUploadModal()">
          إلغاء
        </button>
<button class="flex items-center gap-1 px-space-lg py-2 rounded-lg bg-primary-container text-on-primary font-label-lg text-label-lg hover:bg-primary shadow-md active:scale-95 transition-all" onclick="startUploadProcess()">
<span class="material-symbols-outlined text-[18px]">start</span>
<span>بدء الرفع وإدراج الملف في Pipeline</span>
</button>
</div>
</div>
</div>
<!-- Rejection Reason Dialog Modal -->
<div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm hidden flex items-center justify-center p-space-md transition-opacity" id="rejectModal">
<div class="bg-surface-container-lowest w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden flex flex-col">
<div class="p-space-lg bg-error-container/30 flex items-center justify-between">
<div class="flex items-center gap-space-sm text-error">
<span class="material-symbols-outlined text-[28px]">report_problem</span>
<div>
<h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">رفض المرجع وإيقاف دورة النشر</h3>
<span class="font-label-sm text-label-sm text-error" id="rejectBookNameDisplay">كتاب: ...</span>
</div>
</div>
<button class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:bg-surface-container-high" onclick="closeRejectModal()">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
<div class="p-space-lg flex flex-col gap-space-md">
<div>
<label class="block font-label-sm text-label-sm text-on-surface-variant mb-1">سبب الرفض الموجه للباحث / الأكاديمي الرافع:</label>
<select class="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface focus:outline-none mb-space-sm shadow-sm cursor-pointer" id="rejectReasonPreset">
<option value="security">فشل في الفحص الأمني (اكتشاف كود تنفيذي أو برمجية ضارة)</option>
<option value="copyright">انتهاك حقوق الملكية الفكرية وعدم وجود رخصة توزيع معتمدة</option>
<option value="corrupt">الملف تالف وغير قابل للقراءة الآلية أو توليد الفهارس (OCR Corrupt)</option>
<option value="quality">المحتوى لا يرقى للمعايير الأكاديمية للمقررات</option>
<option value="other">سبب إداري آخر (يرجى التدوين أدناه)</option>
</select>
<textarea class="w-full p-space-md bg-surface-container-low rounded-lg text-body-sm font-body-sm text-on-surface focus:outline-none focus:bg-white shadow-sm resize-none" id="rejectReasonNotes" placeholder="ملاحظات تفصيلية إضافية لإرسالها بالبريد الإلكتروني..." rows="3"></textarea>
</div>
</div>
<div class="p-space-lg bg-surface-container-low flex items-center justify-end gap-space-sm">
<button class="px-space-md py-2 rounded-lg bg-surface-container text-on-surface font-label-lg text-label-lg hover:bg-surface-container-high transition-colors" onclick="closeRejectModal()">
          تراجع
        </button>
<button class="flex items-center gap-1 px-space-lg py-2 rounded-lg bg-error text-on-error font-label-lg text-label-lg hover:bg-error/90 shadow-md active:scale-95 transition-all" onclick="executeRejectAction()">
<span class="material-symbols-outlined text-[18px]">delete_sweep</span>
<span>تأكيد الرفض والإلغاء</span>
</button>
</div>
</div>
</div>
</div>
<script>
  // DOM Elements
  const inspectionDrawer = document.getElementById('inspectionDrawer');
  const drawerBookTitle = document.getElementById('drawerBookTitle');
  const drawerAlertBox = document.getElementById('drawerAlertBox');
  const uploadModal = document.getElementById('uploadModal');
  const uploadModalTrigger = document.getElementById('uploadModalTrigger');
  const rejectModal = document.getElementById('rejectModal');
  const rejectBookNameDisplay = document.getElementById('rejectBookNameDisplay');
  const batchScanBtn = document.getElementById('batchScanBtn');
  const librarySearch = document.getElementById('librarySearch');

  // Trigger Upload Modal
  if (uploadModalTrigger) {
    uploadModalTrigger.addEventListener('click', () => {
      uploadModal.classList.remove('hidden');
    });
  }

  function closeUploadModal() {
    uploadModal.classList.add('hidden');
  }

  function startUploadProcess() {
    closeUploadModal();
    alert('تم بدء رفع الملف وإدراجه في دورة الفحص الآلية بنجاح.');
  }

  // Inspection Drawer Handlers
  function openInspectionDrawer(bookTitle, state) {
    drawerBookTitle.innerText = bookTitle;
    
    // Dynamic styling based on book state
    if (state === 'danger') {
      drawerAlertBox.className = "p-space-md rounded-xl bg-error-container text-on-error-container flex items-start gap-space-sm";
      drawerAlertBox.innerHTML = `
        <span class="material-symbols-outlined text-[24px] text-error mt-0.5">gpp_bad</span>
        <div class="flex flex-col">
          <span class="font-label-lg text-label-lg font-bold">تحذير: الملف يحتوي على تهديد أمني عالي الخطورة!</span>
          <span class="font-body-sm text-body-sm mt-0.5">تم إحباط محاولة لتنفيذ برمجيات حقن صفحات خبيثة داخل كود الـ PDF. يجب تدمير الملف فوراً.</span>
        </div>
      `;
    } else if (state === 'ip_conflict') {
      drawerAlertBox.className = "p-space-md rounded-xl bg-surface-container-high text-tertiary flex items-start gap-space-sm";
      drawerAlertBox.innerHTML = `
        <span class="material-symbols-outlined text-[24px] text-tertiary mt-0.5">policy</span>
        <div class="flex flex-col">
          <span class="font-label-lg text-label-lg font-bold">تنبيه: يلزم ترخيص دار نشر أكاديمية</span>
          <span class="font-body-sm text-body-sm mt-0.5">الملف سليم برمجياً ولكن تم رصد تطابق محتوى يخضع لحقوق النسخ التجاري (Wiley).</span>
        </div>
      `;
    } else {
      drawerAlertBox.className = "p-space-md rounded-xl bg-secondary-fixed text-on-secondary-fixed flex items-start gap-space-sm";
      drawerAlertBox.innerHTML = `
        <span class="material-symbols-outlined text-[24px] text-secondary mt-0.5">task_alt</span>
        <div class="flex flex-col">
          <span class="font-label-lg text-label-lg font-bold">الملف اجتاز جميع متطلبات التوافق الأكاديمي</span>
          <span class="font-body-sm text-body-sm mt-0.5">خالٍ من البرمجيات الضارة ومطابق لمعيار PDF/A الصارم ومجزأ بشكل سليم لفهرسة الذكاء الاصطناعي.</span>
        </div>
      `;
    }

    inspectionDrawer.classList.remove('hidden');
  }

  function closeInspectionDrawer() {
    inspectionDrawer.classList.add('hidden');
  }

  function approveBook() {
    closeInspectionDrawer();
    alert('تم اعتماد ونشر المرجع في المكتبة الرقمية العامة وتحديث فهرس محرك الذكاء الاصطناعي.');
  }

  // Reject Actions
  function promptReject(bookTitle) {
    rejectBookNameDisplay.innerText = "المرجع: " + bookTitle;
    rejectModal.classList.remove('hidden');
  }

  function closeRejectModal() {
    rejectModal.classList.add('hidden');
  }

  function executeRejectAction() {
    closeRejectModal();
    alert('تم رفض المرجع وحذفه من قائمة الانتظار، وإرسال إشعار بالمسببات إلى حساب الرافع.');
  }

  function confirmDestroy() {
    if (confirm('هل أنت متأكد من الحذف النهائي والتطهير الأمني لهذا الملف المشبوه؟ لن يمكن التراجع.')) {
      alert('تم تطهير خوادم التخزين وحذف البصمة الثنائية بنجاح.');
    }
  }

  // Batch Scan Trigger
  if (batchScanBtn) {
    batchScanBtn.addEventListener('click', () => {
      const originalText = batchScanBtn.innerHTML;
      batchScanBtn.innerHTML = `
        <span class="material-symbols-outlined text-[20px] animate-spin">refresh</span>
        <span>جاري الفحص لـ 7 ملفات...</span>
      `;
      setTimeout(() => {
        batchScanBtn.innerHTML = originalText;
        alert('اكتمل الفحص الأمني الجماعي: 5 ملفات سليمة، 1 قيد التحليل، 1 تهديد أمني.');
      }, 1500);
    });
  }

  // Simple client-side search simulation
  if (librarySearch) {
    librarySearch.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      const rows = document.querySelectorAll('tbody tr');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        if (text.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  }
</script></main></div></body></html>